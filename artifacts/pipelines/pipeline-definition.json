{
  "name": "Pipeline_IngestEmployees",
  "properties": {
    "activities": [
      {
        "name": "CopyEmployees",
        "type": "Copy",
        "inputs": [
          {
            "referenceName": "SourceEmployees",
            "type": "DatasetReference"
          }
        ],
        "outputs": [
          {
            "referenceName": "DestinationEmployees",
            "type": "DatasetReference"
          }
        ],
        "typeProperties": {
          "source": {
            "type": "SqlServerSource",
            "sqlReaderQuery": "SELECT EmployeeID, EmployeeName, LastModifiedDate, ModifiedBy FROM dbo.Employees",
            "queryTimeout": "00:02:00"
          },
          "sink": {
            "type": "AzureSqlSink",
            "writeBehavior": "upsert",
            "upsertSettings": {
              "useTempDB": true,
              "keys": ["EmployeeID"]
            },
            "tableOption": "autoCreate"
          },
          "enableStaging": false,
          "translator": {
            "type": "TabularTranslator",
            "mappings": [
              {
                "source": {"name": "EmployeeID", "type": "Int32"},
                "sink": {"name": "EmployeeID", "type": "Int32"}
              },
              {
                "source": {"name": "EmployeeName", "type": "String"},
                "sink": {"name": "EmployeeName", "type": "String"}
              },
              {
                "source": {"name": "LastModifiedDate", "type": "DateTime"},
                "sink": {"name": "LastModifiedDate", "type": "DateTime"}
              },
              {
                "source": {"name": "ModifiedBy", "type": "String"},
                "sink": {"name": "ModifiedBy", "type": "String"}
              }
            ]
          }
        }
      }
    ],
    "annotations": []
  }
}
